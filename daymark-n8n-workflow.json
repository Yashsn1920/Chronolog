        "text": "={{ $json.body.type === 'weekly-summary' ? 'Progress from ' + $json.body.summary.period.start + ' to ' + $json.body.summary.period.end + '\\n\\nProductive days: ' + $json.body.summary.productiveDays + '\\nDays with notes: ' + $json.body.summary.daysWithNotes + '\\nHabits completed: ' + $json.body.summary.habitsCompleted + '\\nTasks completed: ' + $json.body.summary.tasksCompleted + ' of ' + $json.body.summary.tasksTotal + '\\n\\nNotes:\\n' + $json.body.summary.notes.map((item) => item.date + ': ' + item.notes).join('\\n\\n') : $json.body.type === 'test' ? 'Daymark webhook and email delivery test.' : JSON.stringify($json.body.snapshot, null, 2) }}",
        "options": {}
      },
      "id": "57e859a0-7540-4bd8-8d96-e48626c1cbd2",
      "name": "Send Daymark Email",
